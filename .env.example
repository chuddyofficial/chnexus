# Database
DATABASE_URL="postgresql://chnexus:changeme@localhost:5432/chnexus?schema=public"

# Redis (rate limiting)
REDIS_URL="redis://localhost:6379"

# Auth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Used to hash IP addresses in logs/submissions instead of storing them raw
IP_HASH_SALT="generate-a-random-string"

# Resend (email replies from the admin contact inbox). Sign up at
# resend.com, verify your domain, then create an API key.
# Without this set, replying in the admin panel will fail with a clear
# error instead of silently doing nothing.
RESEND_API_KEY="re_..."
